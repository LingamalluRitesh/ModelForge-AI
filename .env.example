# ==============================================================================
# ModelForge AI — Enterprise Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ModelForge AI"
API_V1_STR="/api/v1"
SECRET_KEY=modelforge_super_secret_production_key_change_me_in_prod_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Server Host & Ports
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=modelforge_user
POSTGRES_PASSWORD=modelforge_password
POSTGRES_DB=modelforge_db
DATABASE_URL=postgresql+asyncpg://modelforge_user:modelforge_password@localhost:5432/modelforge_db
DATABASE_URL_SYNC=postgresql://modelforge_user:modelforge_password@localhost:5432/modelforge_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery Distributed Task Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Object Storage (S3 / MinIO Compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data_storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=modelforge-artifacts
S3_REGION=us-east-1
S3_SECURE=false

# MLflow & Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ModelForge-Default

# Monitoring & Observability
PROMETHEUS_METRICS_ENABLED=true
OPENTELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Email & Notifications (SMTP)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=alerts@modelforge.ai
SMTP_PASSWORD=app_specific_password_here
EMAILS_FROM_EMAIL=alerts@modelforge.ai
EMAILS_FROM_NAME="ModelForge AI Platform"

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=120
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
MAX_UPLOAD_SIZE_MB=500
ALLOWED_HOSTS=["*"]

# Super Admin Default Seed
FIRST_SUPERUSER_EMAIL=admin@modelforge.ai
FIRST_SUPERUSER_PASSWORD=AdminSecurePassword123!
FIRST_SUPERUSER_FIRSTNAME=System
FIRST_SUPERUSER_LASTNAME=Admin
FIRST_ORGANIZATION_NAME="ModelForge Global Enterprise"
