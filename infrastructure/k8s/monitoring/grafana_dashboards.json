      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 101,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Model Serving & Real-Time Inference Telemetry",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
          "expr": "sum(rate(modelforge_inference_requests_total[1m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} - {{status}}"
        }
      ],
      "title": "Real-Time Inference Throughput (QPS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
          "expr": "histogram_quantile(0.50, sum(rate(modelforge_inference_latency_ms_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}} (p50)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
          "expr": "histogram_quantile(0.90, sum(rate(modelforge_inference_latency_ms_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}} (p90)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
          "expr": "histogram_quantile(0.99, sum(rate(modelforge_inference_latency_ms_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}} (p99)"
        }
      ],
      "title": "Inference Latency Percentiles (p50, p90, p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "panels": [],
      "title": "Data & Feature Drift Continuous Monitoring",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
          "expr": "modelforge_feature_psi_drift_score",
          "legendFormat": "{{feature}} (PSI)"
        }
      ],
      "title": "Population Stability Index (PSI) Feature Shift",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-prod" },
          "expr": "modelforge_canary_stage_percentage",
          "legendFormat": "{{endpoint}} Canary Traffic Split"
        }
      ],
      "title": "Istio Canary Traffic Routing Percentage",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["modelforge", "mlops", "production", "istio"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "ModelForge AI - Enterprise Model Operations Platform",
  "uid": "modelforge-enterprise-ops",
  "version": 1
}
